# SCPN Mirror Core — local gate entry points

VENV := .venv/bin
PYTHON := $(VENV)/python

.PHONY: venv lock lint typecheck test validate rust docs preflight

venv:
	python3 -m venv .venv
	$(VENV)/pip install --require-virtualenv --require-hashes -r requirements-dev.txt -r requirements-kernels.txt
	$(VENV)/pip install --require-virtualenv --no-deps -e .

# Hash-locked install sets. `make lock` regenerates every requirements-*.txt
# from its lock input and pyproject.toml for the CI interpreter; CI installs
# them with --require-hashes. The first-party kernel library is not on PyPI:
# it is locked by source-archive digest in requirements-kernels.txt, outside
# the PyPI-audited sets.
LOCK := uv pip compile --quiet --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_31
LOCK_HEAD := sed -n '1,6p' requirements-dev.in

lock:
	{ $(LOCK_HEAD); echo "# SCPN Mirror Core — development toolchain lock (generated by make lock)"; \
	  $(LOCK) requirements-dev.in pyproject.toml --no-emit-package scpn-reactor-kernels; } > requirements-dev.txt
	{ $(LOCK_HEAD); echo "# SCPN Mirror Core — development toolchain with the CAD extra lock (generated by make lock)"; \
	  $(LOCK) requirements-dev.in pyproject.toml --extra cad -c requirements-dev.txt --no-emit-package scpn-reactor-kernels; } > requirements-cad.txt
	{ $(LOCK_HEAD); echo "# SCPN Mirror Core — kernel library source-archive lock (generated by make lock)"; \
	  $(LOCK) requirements-kernels.in --no-deps; } > requirements-kernels.txt
	{ $(LOCK_HEAD); echo "# SCPN Mirror Core — native wheel build backend lock (generated by make lock)"; \
	  $(LOCK) requirements-build.in; } > requirements-build.txt
	{ sed -n '1,6p' requirements-audit.in; echo "# SCPN Mirror Core — audit and inventory tooling lock (generated by make lock)"; \
	  $(LOCK) requirements-audit.in; } > requirements-audit.txt

lint:
	$(VENV)/ruff check .
	$(VENV)/ruff format --check .

typecheck:
	$(VENV)/mypy --strict src tools tests benchmarks

test:
	$(VENV)/pytest -q --cov=tools --cov-branch --cov-fail-under=100

validate:
	$(PYTHON) tools/validate_reactor_domain.py reactor-domain.json
	$(PYTHON) tools/derive_studio_descriptor.py --check
	$(PYTHON) tools/generate_capability_inventory.py --check

rust:
	cd rust && cargo fmt --check && cargo clippy --all-targets --features python -- -D warnings && cargo doc --no-deps --features python && cargo test

docs:
	$(PYTHON) tools/preflight.py --only docs

preflight:
	$(PYTHON) tools/preflight.py
